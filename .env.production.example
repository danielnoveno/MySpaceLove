# ============================================================
# LoveSpace - Production Environment Configuration
# ============================================================
# Deploy: Oracle Cloud Always Free + Clever Cloud MySQL
# ============================================================

# --- APP ---
APP_NAME=LoveSpace
APP_ENV=production
APP_KEY=                          # Generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://yourdomain.com    # Atau http://129.154.xx.xx

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# --- DATABASE (Clever Cloud MySQL - Free DEV plan) ---
DB_CONNECTION=mysql
DB_HOST=mysql-xxxxx.clever-cloud.com    # Dari Clever Cloud dashboard
DB_PORT=3306
DB_DATABASE=databases_xxxxx             # Dari Clever Cloud dashboard
DB_USERNAME=uxxxxx                      # Dari Clever Cloud dashboard
DB_PASSWORD=xxxxxxxx                    # Dari Clever Cloud dashboard

# --- SESSION (Database - Gratis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=yourdomain.com           # Atau biarkan kosong jika pakai IP
SANCTUM_STATEFUL_DOMAINS=yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- CACHE (Database - Gratis) ---
CACHE_STORE=database
CACHE_PREFIX=lovespace-cache-

# --- QUEUE (Database - Gratis) ---
QUEUE_CONNECTION=database

# --- BROADCASTING (Log - Gratis) ---
BROADCAST_DRIVER=log

# --- FILESYSTEM (Local di Oracle Cloud - Gratis 200GB) ---
FILESYSTEM_DISK=local

# --- MAIL ---
MAIL_MAILER=log                         # Log dulu, bisa diubah nanti
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- LOGGING ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- SECURITY ---
BCRYPT_ROUNDS=12

# --- PHP ---
PHP_CLI_SERVER_WORKERS=4

# --- MAINTENANCE ---
APP_MAINTENANCE_DRIVER=database

# ============================================================
# OPTIONAL SERVICES
# ============================================================

# --- Google Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Spotify Integration ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI="${APP_URL}/oauth/spotify/callback"
SPOTIFY_SCOPES="user-read-playback-state user-read-recently-played playlist-read-private playlist-modify-private"
SPOTIFY_REFRESH_MARGIN=300

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Video Calling (JaaS) ---
JAAS_APP_ID=
JAAS_API_KEY=
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----"

# --- Vite Frontend ---
VITE_APP_NAME="${APP_NAME}"
