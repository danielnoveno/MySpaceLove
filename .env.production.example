# ============================================================
# LoveSpace - Production Environment (Vercel + Supabase)
# ============================================================

# --- APP ---
APP_NAME=LoveSpace
APP_ENV=production
APP_KEY=                          # Generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-app.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# --- DATABASE (Supabase PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxx.supabase.co   # dari Supabase dashboard → Settings → Database
DB_PORT=5432
DB_DATABASE=postgres               # default: postgres
DB_USERNAME=postgres               # default: postgres
DB_PASSWORD=your-supabase-password  # dari Supabase dashboard → Settings → Database

# --- SESSION (Database - Gratis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- CACHE (Database - Gratis) ---
CACHE_STORE=database
CACHE_PREFIX=lovespace-cache-

# --- QUEUE (Database - Gratis) ---
QUEUE_CONNECTION=database

# --- BROADCASTING (Log - Gratis) ---
BROADCAST_DRIVER=log

# --- FILESYSTEM (Supabase Storage atau S3-compatible) ---
FILESYSTEM_DISK=s3

# --- AWS S3 (Supabase Storage - S3 compatible) ---
AWS_ACCESS_KEY_ID=your-supabase-service-role-key
AWS_SECRET_ACCESS_KEY=your-supabase-service-role-secret
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=your-supabase-project-ref
AWS_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- MAIL (Log - Gratis) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-app.vercel.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- LOGGING ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- SECURITY ---
BCRYPT_ROUNDS=12

# --- PHP ---
PHP_CLI_SERVER_WORKERS=4

# --- MAINTENANCE ---
APP_MAINTENANCE_DRIVER=database

# ============================================================
# OPTIONAL SERVICES
# ============================================================

# --- Google Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Spotify Integration ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI="${APP_URL}/oauth/spotify/callback"
SPOTIFY_SCOPES="user-read-playback-state user-read-recently-played playlist-read-private playlist-modify-private"
SPOTIFY_REFRESH_MARGIN=300

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Video Calling (JaaS) ---
JAAS_APP_ID=
JAAS_API_KEY=
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----"

# --- Vite Frontend ---
VITE_APP_NAME="${APP_NAME}"

# --- Supabase (untuk frontend) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
