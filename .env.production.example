# ============================================================
# LoveSpace - Production Environment Configuration
# ============================================================
# Copy this file and fill in your values
# Deploy to: Railway + PlanetScale + Cloudflare R2
# ============================================================

# --- APP ---
APP_NAME=LoveSpace
APP_ENV=production
APP_KEY=                          # Generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# --- DATABASE (PlanetScale MySQL) ---
DB_CONNECTION=mysql
DB_HOST=aws.connect.psdb.cloud
DB_PORT=3306
DB_DATABASE=lovespace
DB_USERNAME=your_planetscale_username
DB_PASSWORD=your_planetscale_password
DB_SSLMODE=require

# --- SESSION (Database - Free) ---
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.up.railway.app
SANCTUM_STATEFUL_DOMAINS=your-app.up.railway.app
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- CACHE (Database - Free) ---
CACHE_STORE=database
CACHE_PREFIX=lovespace-cache-

# --- QUEUE (Database - Free) ---
QUEUE_CONNECTION=database

# --- BROADCASTING (Log - Free) ---
BROADCAST_DRIVER=log

# --- FILESYSTEM (Cloudflare R2 - Free 10GB) ---
FILESYSTEM_DISK=r2

# --- R2 / S3 Configuration ---
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_KEY=your_r2_access_key
R2_SECRET=your_r2_secret_key
R2_BUCKET=lovespace-uploads
R2_REGION=auto

# --- MAIL (Use Mailtrap/Ressend free tier) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io           # or smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- LOGGING ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- SECURITY ---
BCRYPT_ROUNDS=12

# --- PHP ---
PHP_CLI_SERVER_WORKERS=4

# --- MAINTENANCE ---
APP_MAINTENANCE_DRIVER=database

# ============================================================
# OPTIONAL SERVICES (Enable what you need)
# ============================================================

# --- Google Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Spotify Integration ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI="${APP_URL}/oauth/spotify/callback"
SPOTIFY_SCOPES="user-read-playback-state user-read-recently-played playlist-read-private playlist-modify-private"
SPOTIFY_REFRESH_MARGIN=300

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Video Calling (JaaS) ---
JAAS_APP_ID=
JAAS_API_KEY=
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----"

# --- Agora Video ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Vite Frontend ---
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
