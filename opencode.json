{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "plugin": ["./.opencode/plugins/ponytail.mjs"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "jev-mcp": {
      "type": "local",
      "command": ["jev-mcp"],
      "enabled": true,
      "environment": {
        "TYPESAFE_API_KEY": "{env:TYPESAFE_API_KEY}"
      }
    }
  }
}
