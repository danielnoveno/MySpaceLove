{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/api/index.php?__path=build/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/api/index.php?__path=css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/api/index.php?__path=js/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/api/index.php?__path=images/$1"
    },
    {
      "src": "/fonts/(.*)",
      "dest": "/api/index.php?__path=fonts/$1"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/api/index.php?__path=storage/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/api/index.php?__path=favicon.ico"
    },
    {
      "src": "/favicon.svg",
      "dest": "/api/index.php?__path=favicon.svg"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?__path=$1"
    }
  ]
}
